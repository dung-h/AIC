# The annotation review UI and validators operate on private evidence/holdout
# data. The public service keeps retrieval endpoints and rejects annotation
# routes explicitly when that workspace is absent.
src/service/annotation_review.py

# Retired 2025/research helpers. They have no caller in the competition
# spine; keeping them locally preserves experiment history without exposing
# remote/implicit fallback paths as deployable production capabilities.
