# Role-separated OpenAI-compatible providers. Never commit real credentials.
# Text-only provider, e.g. AI Box. It must not be used for image inputs.
TEXT_BASE_URL=https://api.ai-box.vn/v1
TEXT_API_KEY=
TEXT_MODEL=deepseek-v4-flash

# Vision provider, e.g. a Lightning model whose /models metadata explicitly
# lists image as an input modality. Configure the exact model after a smoke test.
VLM_BASE_URL=https://lightning.ai/api/v1
VLM_API_KEY=
VLM_MODEL=

# Embeddings require a model/provider that implements POST /embeddings.
EMBEDDING_BASE_URL=https://lightning.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Deployment/runtime paths.  These are intentionally optional; the wrappers
# resolve project-local assets first and accept explicit paths on another
# Linux server.  Never commit real credentials.
# HCMAI_PYTHON=/opt/hcmai/.venv/bin/python
# HCMAI_LOCAL_VLM_PATH=/opt/models/Qwen2.5-VL-7B-Instruct
# HCMAI_LOCAL_VLM_4BIT=1
# HF_HUB_CACHE=/opt/models/huggingface/hub
# VQA_MODALITY_MODEL_DIR=/opt/models/bge-m3
# HCMAI_RUNTIME_REMOTE=gdrive:HCMAI-2026/runtime

# Required only for an intentionally approved ASR rebuild. Query-time ASR
# reads the materialized index and has no API-key dependency.
# DEEPGRAM_API_KEY=
