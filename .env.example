# HCMAI runtime configuration (copy to a private `.env`; never commit it).
#
# Precedence is: explicit OS environment > this file > code defaults. Both
# Python and the supported Bash wrappers parse only KEY=VALUE records; `.env`
# is configuration, never executable shell code. Leave an optional setting
# commented out to use its tested default.

# ---------------------------------------------------------------------------
# Optional remote providers. Each role is independent: do not point a text
# endpoint at a VLM endpoint unless its model metadata proves it supports that
# capability. The local competition path needs none of these settings.
# ---------------------------------------------------------------------------
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=

VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
# Lightning Model API example:
# VLM_BASE_URL=https://lightning.ai/api/v1
# VLM_MODEL=openai/gpt-4o
# VLM_API_KEY=<private-lightning-key>

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Only an intentionally approved ASR rebuild/crawl uses this key. Runtime
# retrieval consumes the materialized local ASR index and does not need it.
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Portable runtime paths and transfer settings.
# ---------------------------------------------------------------------------
# HCMAI_DOTENV=/opt/hcmai/.env
# HCMAI_PYTHON=/opt/hcmai/.venv/bin/python
# HCMAI_LOCAL_VLM_PATH=/opt/models/Qwen2.5-VL-7B-Instruct
# HCMAI_LOCAL_VLM_4BIT=1
# VQA_MODALITY_MODEL_DIR=/opt/models/bge-m3
# The published runtime index contains the validated merged v2 source. Point
# this at a separately provisioned experiment only after its own gate passes.
# VQA_ASR_GLOBAL_DIR=/opt/hcmai/data/index/modality_global_v2/asr_global_merged_v2
# HCMAI_TRAKE_ASR_INDEX_DIR=/opt/hcmai/data/index/modality_global_v2/asr_global_merged_v2
# HF_HOME=/opt/models/huggingface
# HF_HUB_CACHE=/opt/models/huggingface/hub
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# TOKENIZERS_PARALLELISM=false
# HCMAI_RUNTIME_REMOTE=gdrive:HCMAI-2026/runtime
# HCMAI_RCLONE_BIN=/usr/bin/rclone
# Public, credential-free bootstrap. Share these three *child folders*, not
# the top-level runtime folder (it contains a legacy raw keyframe tree).
# HCMAI_PUBLIC_INDEX_URL=https://drive.google.com/drive/folders/<index-id>
# HCMAI_PUBLIC_KEYFRAMES_URL=https://drive.google.com/drive/folders/<archive-id>
# HCMAI_PUBLIC_MODELS_URL=https://drive.google.com/drive/folders/<models-id>
# HCMAI_PUBLIC_MODEL_ROOT=/opt/hcmai-models
# HCMAI_PUBLIC_DOWNLOAD_ROOT=/opt/hcmai-downloads

# ---------------------------------------------------------------------------
# Production policy. Defaults are intentionally conservative/offline-first.
# Set only when making an explicit, measured deployment choice.
# ---------------------------------------------------------------------------
# HCMAI_EXECUTION_MODE=production
# HCMAI_NETWORK_MODE=online
# HCMAI_KIS_REMOTE_TRANSLATION=0
# HCMAI_KIS_NLLB_ROUTING=0
# HCMAI_KIS_NLLB_THRESHOLD=0.05
# HCMAI_TRAKE_MODE=visual
# HCMAI_TRAKE_REMOTE_EMBEDDINGS=0
# HCMAI_VKIS_SELECTOR=hybrid0.5
# VQA_MODALITY_ROUTING=0
# VQA_VISUAL_SELECTOR_POLICY=adaptive
# VQA_ANSWER_PROVIDER=local
# Optional external knowledge → local-evidence planning. This is *not* an
# answer source: any returned answer still needs in-corpus ASR/OCR/visual
# evidence and canonical frame mapping. Enable only for a deployment where
# outbound search is permitted; leave off for offline/benchmark runs.
# VQA_EXTERNAL_GROUNDING=0
# VQA_EXTERNAL_SEARCH_BACKEND=searxng
# VQA_EXTERNAL_SEARCH_URL=https://<your-searxng-host>
# VQA_EXTERNAL_ALLOWED_DOMAINS=baokhanhhoa.vn,tuoitrephatgiaohoahao.com
# VQA_EXTERNAL_TIMEOUT_SECONDS=5
# Optional LLM planner. It proposes bounded retrieval hypotheses only; it
# requires external grounding and never supplies an answer/frame itself.
# VQA_HYPOTHESIS_GENERATION=0
# Separate OOK visual-entity branch: web image → local VKIS retrieval. The
# downloaded image is a transient query reference, never a submitted frame.
# VQA_EXTERNAL_IMAGE_GROUNDING=0
# VQA_EXTERNAL_IMAGE_ALLOWED_DOMAINS=commons.wikimedia.org,example.org
# VQA_EXTERNAL_IMAGE_ALLOW_ANY_HOST=0
# VQA_EXTERNAL_IMAGE_MAX_REFERENCES=3
# Optional second-pass VLM/API precision gate. It can only accept/reject an
# answer on an already canonical local evidence bundle; it is not a fallback.
# VQA_SEMANTIC_EVIDENCE_VERIFIER=0
# HCMAI_PRELOAD_TRAKE=0
# HCMAI_ENABLE_RESEARCH_ROUTES=0
# HCMAI_VQA_FALLBACK_POLICY=fail_closed

# Explicit TRAKE alignment policy.  These are captured by RuntimePolicy and
# therefore traceable/reproducible; promotion still requires a benchmark.
# HCMAI_TRAKE_MULTIMODAL_ALIGNMENT_POLICY=legacy
# HCMAI_TRAKE_VISUAL_ALIGNMENT_POLICY=legacy
# HCMAI_TRAKE_VISUAL_CANDIDATE_VIDEO_LIMIT=20

# Web/demo-only provenance selector; not required by competition entrypoints.
# HCMAI_ANNOTATION_PACK=
