# HCMAI runtime configuration (copy to a private `.env`; never commit it).
#
# Precedence is: explicit OS environment > this file > code defaults. Both
# Python and the supported Bash wrappers parse only KEY=VALUE records; `.env`
# is configuration, never executable shell code. Leave an optional setting
# commented out to use its tested default.

# ---------------------------------------------------------------------------
# Optional remote providers. Each role is independent: do not point a text
# endpoint at a VLM endpoint unless its model metadata proves it supports that
# capability. The local competition path needs none of these settings.
# ---------------------------------------------------------------------------
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=

VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Only an intentionally approved ASR rebuild/crawl uses this key. Runtime
# retrieval consumes the materialized local ASR index and does not need it.
DEEPGRAM_API_KEY=

# ---------------------------------------------------------------------------
# Portable runtime paths and transfer settings.
# ---------------------------------------------------------------------------
# HCMAI_DOTENV=/opt/hcmai/.env
# HCMAI_PYTHON=/opt/hcmai/.venv/bin/python
# HCMAI_LOCAL_VLM_PATH=/opt/models/Qwen2.5-VL-7B-Instruct
# HCMAI_LOCAL_VLM_4BIT=1
# VQA_MODALITY_MODEL_DIR=/opt/models/bge-m3
# HCMAI_TRAKE_ASR_INDEX_DIR=/opt/hcmai/data/index/modality_global_v2/asr_global_merged_v2
# HF_HOME=/opt/models/huggingface
# HF_HUB_CACHE=/opt/models/huggingface/hub
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# TOKENIZERS_PARALLELISM=false
# HCMAI_RUNTIME_REMOTE=gdrive:HCMAI-2026/runtime
# HCMAI_RCLONE_BIN=/usr/bin/rclone

# ---------------------------------------------------------------------------
# Production policy. Defaults are intentionally conservative/offline-first.
# Set only when making an explicit, measured deployment choice.
# ---------------------------------------------------------------------------
# HCMAI_EXECUTION_MODE=production
# HCMAI_NETWORK_MODE=online
# HCMAI_KIS_REMOTE_TRANSLATION=0
# HCMAI_KIS_NLLB_ROUTING=0
# HCMAI_KIS_NLLB_THRESHOLD=0.05
# HCMAI_TRAKE_MODE=visual
# HCMAI_TRAKE_REMOTE_EMBEDDINGS=0
# HCMAI_VKIS_SELECTOR=hybrid0.5
# VQA_MODALITY_ROUTING=0
# VQA_VISUAL_SELECTOR_POLICY=adaptive
# VQA_ANSWER_PROVIDER=local
# HCMAI_PRELOAD_TRAKE=0
# HCMAI_ENABLE_RESEARCH_ROUTES=0
# HCMAI_VQA_FALLBACK_POLICY=fail_closed

# Explicit TRAKE research knobs. They are not part of the default production
# route and must be backed by a benchmark before promotion.
# TRAKE_ALIGNMENT_POLICY=legacy
# TRAKE_VISUAL_ALIGNMENT_POLICY=legacy
# TRAKE_VISUAL_CANDIDATE_VIDEO_LIMIT=20

# Web/demo-only provenance selector; not required by competition entrypoints.
# HCMAI_ANNOTATION_PACK=
